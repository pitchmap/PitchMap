# ── 필수 ──────────────────────────────────────────────────────
# 카카오 JavaScript 앱 키 (kakao developers.kakao.com → 내 애플리케이션)
KAKAO_APP_KEY=your_kakao_javascript_app_key

# 실행 환경: development | production
ENV=production

# 프론트엔드 도메인 (쉼표로 여러 개 가능, 스킴 포함)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── 선택 ──────────────────────────────────────────────────────
# 서버 포트 (Railway/Render가 $PORT 자동 주입)
PORT=8000

# 캐시 TTL (초). Render 무료: 900(15분) / 유료: 1800(30분)
CACHE_TTL=900
CACHE_STALE_TTL=14400

# Playwright 활성화 여부 (Render 무료 tier: false 권장)
ENABLE_PLAYWRIGHT=false
